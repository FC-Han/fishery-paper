# DeepSeek API Key（必须，用于 AI 中文总结）
# 获取地址：https://platform.deepseek.com/
# 费用极低：约 1元/百万输入token，2元/百万输出token
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx

# Semantic Scholar API Key（可选，增强论文覆盖）
# 免费注册：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=xxxxxxxxxxxxx

# ===== 语义检索（可选，不填则站点只用 BM25）=====
# embedding 服务商。DeepSeek 没有 embeddings 接口，得另接一家，以下三家都是 OpenAI 兼容格式：
#   硅基流动 https://api.siliconflow.cn/v1/embeddings     模型 BAAI/bge-m3（1024 维，免费额度够用）
#   智谱     https://open.bigmodel.cn/api/paas/v4/embeddings  模型 embedding-3
#   阿里百炼 https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings  模型 text-embedding-v4
EMBED_API_KEY=sk-xxxxxxxxxxxxx
EMBED_API_BASE=https://api.siliconflow.cn/v1/embeddings
EMBED_MODEL=BAAI/bge-m3

# 前端调用的代理地址（部署在 Vercel 上的 api/embed.js）
# 构建站点时读取；留空 = 不做语义检索，站点只用 BM25
# 用生产别名或分支别名，不要用带部署 ID（如 -7xu5vn9i3-）的地址，那个写死在某次部署上
EMBED_ENDPOINT=https://fishery-paper.vercel.app/api/embed

# ===== 问一问 / RAG（可选，不填则只给召回结果、不生成答案）=====
# DeepSeek 的 key 只放在 Vercel 的 api/ask.js 里，不要写进前端
# Vercel → Settings → Environment Variables 加 DEEPSEEK_API_KEY，然后 Redeploy
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx
# 前端调用的问答代理地址，构建站点时烧进 HTML
ASK_ENDPOINT=https://fishery-paper.vercel.app/api/ask

# 注意：GitHub Actions 里这四项要分开配——
#   Secrets   → EMBED_API_KEY
#   Variables → EMBED_API_BASE / EMBED_MODEL / EMBED_ENDPOINT
# 放错标签页不会报错，只会拿到空字符串然后静默跳过。详见 VERCEL.md

