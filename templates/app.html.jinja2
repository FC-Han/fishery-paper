<script id="payload" type="application/json">{{ data_json | safe }}</script>
<script>
(function(){
  "use strict";
  const DATA = JSON.parse(document.getElementById('payload').textContent);
  const PAPERS = DATA.papers;
  const EMBED_API = {{ embed_api | tojson }};   // 空字符串 = 未接语义检索，退回纯 BM25
  const ASK_API = {{ ask_api | tojson }};       // 空字符串 = 未配问答代理，按钮隐藏
  const FEED_URL = {{ feed_url | tojson }};
  const LEX = DATA.lexicon;
  const DIMS = [
    {key:'theme',   label:'研究主题'},
    {key:'species', label:'研究鱼种'},
    {key:'region',  label:'海域区域'},
    {key:'method',  label:'方法手段'}
  ];
  const META = {};
  LEX.forEach(t => { META[t.dim + '|' + t.id] = t; });
  const BY_DOI = {};
  PAPERS.forEach(p => { BY_DOI[p.doi] = p; });

  // ---------- 状态 ----------
  const state = {
    q: '',
    hits: null,      // Map(doi -> BM25 分数)，null 表示未检索
    hl: null,        // 高亮词面
    qterms: [],      // 结果条上展示的关键词
    qwide: false,    // 是否已放宽匹配
    qused: 0,
    qtotal: 0,
    qms: 0,
    sem: null,       // Map(doi -> 余弦)，语义增强结果；null 表示未启用/未就绪
    bmax: 0,
    semAdded: 0,
    dims: {theme:new Set(), species:new Set(), region:new Set(), method:new Set()},
    journals: new Set(),
    range: 'all',
    sort: 'date',
    limit: 60,
    favOnly: false,   // 只看收藏
    sel: new Set()    // 批量勾选的 doi
  };

  // ---------- 工具 ----------
  const $ = s => document.querySelector(s);
  const esc = s => String(s == null ? '' : s)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;');
  const WD = ['周日','周一','周二','周三','周四','周五','周六'];
  const parseDate = d => { const [y,m,dd] = d.split('-').map(Number); return new Date(y, m-1, dd); };
  const MAXD = PAPERS.length ? parseDate(PAPERS[0].date > PAPERS[PAPERS.length-1].date ? PAPERS[0].date : PAPERS[PAPERS.length-1].date) : new Date();
  const newestDate = PAPERS.reduce((a,p) => p.date > a ? p.date : a, '0000-00-00');
  const ANCHOR = newestDate !== '0000-00-00' ? parseDate(newestDate) : new Date();

  // ---------- 剪贴板 / 下载 / 轻提示 ----------
  function copyText(t){
    if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(t);
    return new Promise((ok, bad) => {
      const ta = document.createElement('textarea');
      ta.value = t; ta.style.cssText = 'position:fixed;top:-9999px;opacity:0';
      document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy') ? ok() : bad(new Error('copy')); }
      catch (e){ bad(e); }
      ta.remove();
    });
  }
  function saveFile(name, text, mime){
    const blob = new Blob([text], {type: mime || 'text/plain;charset=utf-8'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click();
    setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 1200);
  }
  let toastTimer = null;
  function toast(msg){
    let el = $('#toast');
    if (!el){ el = document.createElement('div'); el.id = 'toast'; el.className = 'toast'; document.body.appendChild(el); }
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove('show'), 1900);
  }

  // ---------- BibTeX ----------
  const bibEsc = s => String(s || '').replace(/([&%$#_])/g, '\\$1').replace(/\s+/g, ' ').trim();
  function bibKey(p){
    const first = ((p.authors || '').split(';')[0] || '').split(',')[0].replace(/[^A-Za-z]/g, '') || 'ref';
    const y = (p.date || '').slice(0, 4);
    const w = ((p.title || '').split(/\s+/).find(x => x.length > 3 && /^[a-z]/i.test(x)) || '')
      .replace(/[^A-Za-z]/g, '').toLowerCase();
    return (first.toLowerCase() + y + w) || ('ref' + y);
  }
  function bibtex(p){
    const au = (p.authors || '').split(';').map(s => s.trim()).filter(Boolean).join(' and ');
    const lines = [
      `@article{${bibKey(p)},`,
      `  title   = {${bibEsc(p.title)}},`,
      au ? `  author  = {${bibEsc(au)}},` : '',
      p.journal ? `  journal = {${bibEsc(p.journal)}},` : '',
      p.date ? `  year    = {${p.date.slice(0, 4)}},` : '',
      p.doi ? `  doi     = {${p.doi}},` : '',
      p.url ? `  url     = {${p.url}}` : '',
      '}',
    ].filter(Boolean);
    return lines.join('\n');
  }
  function bibAll(list){
    const head = `% Fishery Digest · ${list.length} records · ${new Date().toISOString().slice(0, 10)}\n\n`;
    return head + list.map(bibtex).join('\n\n') + '\n';
  }
  function copyBib(list, label){
    const text = list.length === 1 ? bibtex(list[0]) : bibAll(list);
    copyText(text)
      .then(() => toast(list.length === 1 ? 'BibTeX 已复制，粘进 .bib 或用 \u005cparencite' : `已复制 ${list.length} 条 BibTeX`))
      .catch(() => { saveFile('fishery-refs.bib', text, 'application/x-bibtex'); toast('复制受限，已下载 .bib'); });
  }

  // ---------- 收藏（localStorage） ----------
  const FAV_KEY = 'fd:fav:v1';
  let FAV = new Set();
  try { FAV = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]')); } catch (e){ FAV = new Set(); }
  function saveFav(){
    try { localStorage.setItem(FAV_KEY, JSON.stringify([...FAV])); } catch (e){}
    $('#favCnt').textContent = FAV.size;
    $('#favBtn').classList.toggle('hide-cnt', FAV.size === 0);
    $('#favBtn').classList.toggle('on', state.favOnly);
  }

  // 预建检索文本
  PAPERS.forEach(p => {
    const tagText = DIMS.map(d => (p.tags[d.key] || []).map(id => {
      const m = META[d.key + '|' + id];
      return m ? (m.zh + ' ' + (m.en || '')) : id;
    }).join(' ')).join(' ');
    p._tagtext = tagText;
    p._text = [p.title, p.summary, p.journal, p.authors, tagText].join(' ').toLowerCase();
    p._tagset = {};
    DIMS.forEach(d => { p._tagset[d.key] = new Set(p.tags[d.key] || []); });
    p._ts = parseDate(p.date).getTime();
  });

  // ---------- BM25 检索 ----------
  // 中文无词典分词：CJK 连续段切 bigram（"大黄鱼" → 大黄 / 黄鱼），英文按词
  const STOP = new Set((
    '的 了 和 与 及 在 对 为 是 有 中 上 下 之 其 等 或 被 从 由 以 而 就 但 也 都 很 不 这 那 ' +
    '我们 本文 该 一个 一种 以及 通过 进行 基于 可以 ' +
    'the a an of and or in on for to with from by at as is are was were be been being ' +
    'this that these those we our its it their using used based study studies research new novel'
  ).split(/\s+/));

  function tokenize(s){
    const out = [];
    const re = /[\u3400-\u4dbf\u4e00-\u9fff]+|[a-z0-9][a-z0-9'\-]*/g;
    const norm = String(s == null ? '' : s).toLowerCase().normalize('NFKC');
    let m;
    while ((m = re.exec(norm)) !== null){
      const t = m[0];
      if (/^[a-z0-9]/.test(t)){
        if (t.length > 1 && !STOP.has(t)) out.push(t);
        else if (t.length === 1 && /\d/.test(t)) out.push(t);
      } else if (t.length === 1){
        if (!STOP.has(t)) out.push(t);
      } else {
        for (let i = 0; i < t.length - 1; i++){
          const bg = t.slice(i, i + 2);
          if (!STOP.has(bg)) out.push(bg);
        }
      }
    }
    return out;
  }

  const BM25 = (function(){
    const K1 = 1.35, B = 0.72;
    const FW = { title: 3.2, tags: 2.2, journal: 1.8, summary: 1.0, authors: 0.7 };
    const N = PAPERS.length;
    const docs = new Array(N);
    const post = new Map();   // term -> [docIdx, ...]
    const idf = new Map();

    for (let i = 0; i < N; i++){
      const p = PAPERS[i];
      const tf = new Map();
      const add = (txt, w) => {
        const tk = tokenize(txt);
        for (let k = 0; k < tk.length; k++) tf.set(tk[k], (tf.get(tk[k]) || 0) + w);
      };
      add(p.title, FW.title);
      add(p._tagtext, FW.tags);
      add(p.journal, FW.journal);
      add(p.summary, FW.summary);
      add(p.authors, FW.authors);
      let len = 0;
      tf.forEach(v => { len += v; });
      docs[i] = { len, tf };
      tf.forEach((_, t) => {
        let a = post.get(t);
        if (!a) post.set(t, a = []);
        a.push(i);
      });
    }
    const avg = docs.reduce((s, d) => s + d.len, 0) / Math.max(1, N);
    post.forEach((list, t) => {
      const df = list.length;
      idf.set(t, Math.log(1 + (N - df + 0.5) / (df + 0.5)));
    });

    // 未登录词回退：中文单字、词表外短词直接扫原文
    function fallbackPosting(t){
      const arr = [];
      if (t.length > 3) return arr;
      for (let i = 0; i < N; i++) if (PAPERS[i]._text.indexOf(t) >= 0) arr.push(i);
      return arr;
    }

    // 返回 { hits: Map(doi -> score), terms, wide, used, total, ms }
    function search(raw){
      const t0 = performance.now();
      const terms = Array.from(new Set(tokenize(raw)));
      if (!terms.length) return null;

      // 收集倒排；未登录词（中文单字等）回退到原文扫描
      const items = [];
      terms.forEach(t => {
        // 中文单字：倒排里只有被标点切断的零散片段，必须全量扫描
        let list = /^[\u3400-\u4dbf\u4e00-\u9fff]$/.test(t) ? fallbackPosting(t) : (post.get(t) || fallbackPosting(t));
        if (!list.length) return;
        const d = idf.has(t) ? idf.get(t) : Math.log(1 + (N - list.length + 0.5) / (list.length + 0.5));
        items.push({ t, list, idf: d });
      });
      if (!items.length) return { hits: new Map(), terms, wide: false, used: 0, total: terms.length, ms: 0 };

      // 逐级放宽：先要求全部词同时命中，空则依次丢掉最不具区分度的词
      items.sort((a, b) => b.idf - a.idf);
      let used = items.length, cover = null;
      for (let k = items.length; k >= 1; k--){
        const cnt = new Int16Array(N);
        for (let j = 0; j < k; j++){
          const list = items[j].list;
          for (let x = 0; x < list.length; x++) cnt[list[x]]++;
        }
        let hit = 0;
        for (let i = 0; i < N; i++) if (cnt[i] === k) hit++;
        if (hit){ used = k; cover = cnt; break; }
      }
      if (!cover) return { hits: new Map(), terms, wide: false, used: 0, total: terms.length, ms: 0 };

      // 打分仍用全部词项（排序质量更好），只保留满足当前放宽级别的文档
      const sc = new Float64Array(N);
      items.forEach(({ t, list, idf: d }) => {
        for (let x = 0; x < list.length; x++){
          const i = list[x];
          const tf = docs[i].tf.has(t) ? docs[i].tf.get(t) : 1;
          const norm = 1 - B + B * docs[i].len / avg;
          sc[i] += d * (tf * (K1 + 1)) / (tf + K1 * norm);
        }
      });

      const hits = new Map();
      for (let i = 0; i < N; i++) if (cover[i] === used && sc[i] > 0) hits.set(PAPERS[i].doi, sc[i]);
      return { hits, terms, wide: used < items.length, used, total: terms.length, ms: performance.now() - t0 };
    }

    return { search };
  })();

  // ---------- 语义检索（可选） ----------
  // 文档向量是离线算好的（scripts/build_embeddings.py，int8 量化），浏览器直接拿走；
  // 只有「查询向量」要实时算，走 Vercel 上的 /api/embed 代理，key 不进前端。
  const EMB = {
    api: EMBED_API,
    ready: false, loading: null, dim: 0, mat: null, norms: null, rowOf: null, model: '',
    failAt: 0                 // 上次失败时间戳，用于熔断冷却
  };
  const SEM_MIN = 0.34;     // 余弦低于此值视为不相关，不进候选集
  const SEM_TOPK = 60;      // 语义独有候选最多补这么多篇

  function loadEmb(){
    if (!EMB.api || EMB.ready) return Promise.resolve(EMB.ready);
    if (EMB.loading) return EMB.loading;
    EMB.loading = (async () => {
      try {
        const meta = await fetch('data/emb.json').then(r => r.ok ? r.json() : null);
        if (!meta || !meta.dim || !meta.count) return false;
        const buf = await fetch('data/emb.bin').then(r => r.ok ? r.arrayBuffer() : null);
        if (!buf || buf.byteLength < meta.dim * meta.count) return false;
        const dim = meta.dim, n = meta.count;
        const mat = new Int8Array(buf, 0, dim * n);
        const norms = new Float32Array(n);
        for (let i = 0; i < n; i++){
          let s = 0;
          for (let k = 0, off = i * dim; k < dim; k++){ const x = mat[off + k] / 127; s += x * x; }
          norms[i] = Math.sqrt(s) || 1;
        }
        const rowOf = {};
        meta.items.forEach((it, i) => { rowOf[it.doi] = i; });
        Object.assign(EMB, { ready: true, dim, mat, norms, rowOf, model: meta.model });
        return true;
      } catch (_) { return false; }
    })();
    return EMB.loading;
  }

  // 端点不可达时（大陆直连 vercel.app 可能如此）不能一直等，但也不能太紧：
  // Vercel 冷启动 1~2s + 服务商 embedding 0.5~1.5s，2.5s 会把正常请求也砍掉。
  // 6s 超时 + 5 分钟熔断：首次失败后不再反复拖累搜索。
  async function semanticScores(text){
    if (EMB.failAt && Date.now() - EMB.failAt < 300000) throw new Error('cooling down');
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), 6000);
    let r;
    try {
      r = await fetch(EMB.api, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
        signal: ctl.signal
      });
    } catch (e) {
      EMB.failAt = Date.now();
      throw e;
    } finally {
      clearTimeout(timer);
    }
    if (!r.ok){ EMB.failAt = Date.now(); throw new Error('embed ' + r.status); }
    const j = await r.json();
    // 代理返回 {v:[...]}；直连服务商时是 {data:[{embedding:[...]}]}，两种都认
    const q = j && (j.v || (j.data && j.data[0] && j.data[0].embedding));
    if (!Array.isArray(q) || q.length !== EMB.dim) throw new Error('dim mismatch');
    let qn = 0;
    for (let i = 0; i < q.length; i++) qn += q[i] * q[i];
    qn = Math.sqrt(qn) || 1;
    const out = new Map();
    const { dim, mat, norms, rowOf } = EMB;
    for (let i = 0; i < PAPERS.length; i++){
      const row = rowOf[PAPERS[i].doi];
      if (row === undefined) continue;
      let s = 0;
      for (let k = 0, off = row * dim; k < dim; k++) s += mat[off + k] * q[k];
      out.set(PAPERS[i].doi, (s / 127) / norms[row] / qn);
    }
    return out;
  }

  let semSeq = 0;
  function enrichSemantic(q){
    const my = ++semSeq;
    const go = EMB.ready ? Promise.resolve(true) : loadEmb();
    go.then(ok => { if (ok && my === semSeq && state.q === q && !state.sem) doSemantic(q, my); });
  }
  function doSemantic(q, my){
    semanticScores(q).then(cos => {
      if (my !== semSeq || state.q !== q) return;      // 用户已经改了关键词
      state.sem = cos;
      // 语义独有的候选补进结果集（BM25 一个都没命中时也能有语义召回）
      let added = 0;
      const cands = Array.from(cos.entries()).filter(([d]) => !state.hits.has(d))
        .sort((a, b) => b[1] - a[1]);
      for (const [doi, c] of cands){
        if (added >= SEM_TOPK || c < SEM_MIN) break;
        state.hits.set(doi, 0);
        added++;
      }
      state.semAdded = added;
      if (state.sort === 'date' && state.hits.size){   // BM25 没命中、靠语义捞回来的情况
        state.sort = 'rel';
        const ss = $('#sortSel'); if (ss) ss.value = 'rel';
      }
      renderSide();
      renderList();
    }).catch(e => {
      state.sem = null;
      console.warn('[语义检索未生效]', (e && e.message) || e,
        '\n排查：1) 页面来源是否为 https://fc-han.github.io 2) /api/embed 能否 POST 通 3) Vercel 里 EMBED_API_KEY 是否已配');
    });
  }

  function relScore(p){
    const b = state.hits.get(p.doi) || 0;
    const bn = state.bmax ? b / state.bmax : 0;
    let sn = 0;
    if (state.sem){
      const c = state.sem.get(p.doi);
      if (c !== undefined) sn = Math.max(0, Math.min(1, (c - 0.25) / 0.6));
    }
    return 0.55 * bn + 0.45 * sn;
  }

  // 高亮用的词面（英文按词、中文按段；长中文段补 bigram 兜底）
  function queryTerms(raw){
    const out = [];
    const re = /[\u3400-\u4dbf\u4e00-\u9fff]+|[A-Za-z0-9][A-Za-z0-9'\-]*/g;
    let m;
    while ((m = re.exec(String(raw || ''))) !== null){
      const t = m[0];
      out.push(t);
      if (/^[\u3400-\u9fff]+$/.test(t) && t.length > 3){
        for (let i = 0; i < t.length - 1; i++) out.push(t.slice(i, i + 2));
      }
    }
    const uniq = Array.from(new Set(out.filter(Boolean)));
    uniq.sort((a, b) => b.length - a.length);
    return uniq;
  }

  const RE_CACHE = {};
  function hl(text){
    const s = String(text == null ? '' : text);
    const terms = state.hl;
    if (!terms || !terms.length) return esc(s);
    const key = terms.join('\u0000');
    let re = RE_CACHE[key];
    if (!re){
      const pat = terms.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
      re = RE_CACHE[key] = new RegExp('(' + pat + ')', 'gi');
    }
    re.lastIndex = 0;
    let out = '', last = 0, m;
    while ((m = re.exec(s)) !== null){
      if (!m[0].length){ re.lastIndex++; continue; }
      out += esc(s.slice(last, m.index)) + '<mark class="hl">' + esc(m[0]) + '</mark>';
      last = m.index + m[0].length;
    }
    return out + esc(s.slice(last));
  }

  // ---------- 筛选 ----------
  function rangeOK(p){
    if (state.range === 'all') return true;
    const n = Number(state.range);
    const diff = Math.round((ANCHOR - parseDate(p.date)) / 86400000);
    return diff < n;
  }
  function dimOK(p, key, skipKey){
    const sel = state.dims[key];
    if (!sel || !sel.size || key === skipKey) return true;
    for (const id of sel) if (p._tagset[key].has(id)) return true;
    return false;
  }
  function journalOK(p, skip){
    if (skip || !state.journals.size) return true;
    return state.journals.has(p.journal);
  }
  function qOK(p){
    return !state.hits || state.hits.has(p.doi);
  }
  function matches(p, skipKey){
    if (p.off_topic) return false;
    if (state.favOnly && !FAV.has(p.doi)) return false;
    if (!rangeOK(p) || !journalOK(p, skipKey === 'journal') || !qOK(p)) return false;
    for (const d of DIMS) if (!dimOK(p, d.key, skipKey)) return false;
    return true;
  }

  function displayTerms(raw){
    const out = [];
    const re = /[\u3400-\u4dbf\u4e00-\u9fff]+|[A-Za-z0-9][A-Za-z0-9'\-]*/g;
    let m;
    while ((m = re.exec(String(raw || ''))) !== null) out.push(m[0]);
    return Array.from(new Set(out)).slice(0, 6);
  }

  function setQuery(raw){
    const v = String(raw == null ? '' : raw).trim();
    state.q = v;
    state.sem = null; state.semAdded = 0; state.bmax = 0;
    if (!v){
      state.hits = null; state.hl = null; state.qterms = [];
      state.qwide = false; state.qused = 0; state.qtotal = 0; state.qms = 0;
      if (state.sort === 'rel'){
        state.sort = 'date';
        const ss = $('#sortSel'); if (ss) ss.value = 'date';
      }
      return;
    }
    const r = BM25.search(v);
    state.hits = r ? r.hits : new Map();
    state.qwide = r ? r.wide : false;
    state.qused = r ? r.used : 0;
    state.qtotal = r ? r.total : 0;
    state.qms = r ? r.ms : 0;
    state.qterms = displayTerms(v);
    state.hl = queryTerms(v);
    state.hits.forEach(s => { if (s > state.bmax) state.bmax = s; });
    if (v.length >= 2) enrichSemantic(v);
    if (state.sort === 'date' && state.hits.size){
      state.sort = 'rel';
      const ss = $('#sortSel'); if (ss) ss.value = 'rel';
    }
  }

  // ---------- 侧栏渲染 ----------
  const expanded = {};
  function countBy(dimKey){
    const pool = PAPERS.filter(p => matches(p, dimKey));
    const c = {};
    pool.forEach(p => (p.tags[dimKey] || []).forEach(id => { c[id] = (c[id] || 0) + 1; }));
    return c;
  }
  function renderSide(){
    const html = [];
    DIMS.forEach(d => {
      const c = countBy(d.key);
      let items = Object.keys(c).map(id => ({id, n:c[id], meta: META[d.key+'|'+id] || {zh:id}}))
        .sort((a,b) => b.n - a.n);
      if (!items.length) return;
      const isEx = !!expanded[d.key];
      const shown = isEx ? items : items.slice(0, 9);
      const hasSel = state.dims[d.key].size > 0;
      html.push(`<div class="side-block${hasSel?' has-sel':''}" data-block="${d.key}">
        <div class="side-title"><span>${d.label}</span>
          <button class="lnk" data-reset="${d.key}">清除</button></div>
        <div class="chips">${shown.map(it => {
          const on = state.dims[d.key].has(it.id);
          return `<button class="chip${on?' on':''}${it.n===0&&!on?' zero':''}" data-dim="${d.key}" data-id="${esc(it.id)}" title="${esc(it.meta.en||'')}">
            <span class="zh">${esc(it.meta.zh)}</span><span class="n">${it.n}</span></button>`;
        }).join('')}</div>
        ${items.length > 9 ? `<button class="more-btn" data-more="${d.key}">${isEx?'收起':'展开全部 '+items.length+' 个'}</button>` : ''}
      </div>`);
    });

    // 期刊
    const jpool = PAPERS.filter(p => matches(p, 'journal'));
    const jc = {};
    jpool.forEach(p => { if (p.journal) jc[p.journal] = (jc[p.journal]||0)+1; });
    const jitems = Object.keys(jc).map(j => ({id:j, n:jc[j]})).sort((a,b)=> b.n-a.n || a.id.localeCompare(b.id));
    if (jitems.length){
      const isEx = !!expanded.journal;
      const shown = isEx ? jitems : jitems.slice(0, 8);
      html.push(`<div class="side-block${state.journals.size?' has-sel':''}" data-block="journal">
        <div class="side-title"><span>期刊来源</span><button class="lnk" data-reset="journal">清除</button></div>
        <div class="chips">${shown.map(it => {
          const on = state.journals.has(it.id);
          return `<button class="chip${on?' on':''}${it.n===0&&!on?' zero':''}" data-dim="journal" data-id="${esc(it.id)}">
            <span class="zh">${esc(it.id)}</span><span class="n">${it.n}</span></button>`;
        }).join('')}</div>
        ${jitems.length > 8 ? `<button class="more-btn" data-more="journal">${isEx?'收起':'展开全部 '+jitems.length+' 本'}</button>` : ''}
      </div>`);
    }
    $('#filterSections').innerHTML = html.join('');
  }

  // ---------- 列表渲染 ----------
  function sortPapers(arr){
    const a = arr.slice();
    if (state.sort === 'rel' && state.hits){
      a.sort((x,y) => relScore(y) - relScore(x) || (y.date>x.date?1:-1));
    }
    else if (state.sort === 'journal') a.sort((x,y) => x.journal.localeCompare(y.journal) || (y.date>x.date?1:-1));
    else if (state.sort === 'hi') a.sort((x,y) => (y.high_impact?1:0)-(x.high_impact?1:0) || (y.date>x.date?1:-1));
    else a.sort((x,y) => (y.date>x.date?1:-1) || x.journal.localeCompare(y.journal));
    return a;
  }

  function authorsHTML(p){
    const list = (p.authors || '').split(';').map(s => s.trim()).filter(Boolean);
    if (!list.length) return '—';
    const shown = list.slice(0, 2);
    const more = list.length - shown.length;
    return shown.map(a =>
      `<button class="author-link" data-author="${esc(a)}" title="查看 ${esc(a)} 的全部论文">${esc(a)}</button>`
    ).join('、') + (more > 0 ? `<span style="opacity:.75"> 等 ${list.length} 人</span>` : '');
  }

  function cardHTML(p){
    const tags = [];
    DIMS.forEach(d => (p.tags[d.key]||[]).forEach(id => {
      const m = META[d.key+'|'+id]; if (!m) return;
      tags.push(`<button class="tg" data-dim="${d.key}" data-id="${esc(id)}" title="筛选：${esc(m.zh)}">${esc(m.zh)}</button>`);
    }));
    const hi = p.high_impact ? '<span class="badge hi">高影响</span>' : '';
    const rev = p.is_review ? '<span class="badge rev">综述</span>' : '';
    const favOn = FAV.has(p.doi);
    const tools = `<span class="card-tools">
        <button class="icon-mini${favOn ? ' on' : ''}" data-fav="${esc(p.doi)}"
          title="${favOn ? '取消收藏' : '收藏（存本地，可导出 BibTeX）'}">${favOn ? '★' : '☆'}</button>
        <button class="sel-box${state.sel.has(p.doi) ? ' on' : ''}" data-sel="${esc(p.doi)}"
          title="勾选后可批量导出">✓</button>
      </span>`;
    const sum = p.summary
      ? `<p class="summary${p.summary_en ? ' en' : ''}">${hl(p.summary)}</p>`
      : '';
    const rels = p.rel || [];
    const relBtn = rels.length
      ? `<button class="foot-btn rel-btn"><span class="ar">▶</span>相关 ${rels.length}</button>` : '';
    // 按相似度阈值取到的全部关联，只在视觉上折叠前 6 条，数据不截断
    const relPanel = rels.length
      ? `<div class="rel-panel">
          <div class="rel-head">相关文献<span class="sp"></span>
            <button class="rel-graph-btn" data-graph="${esc(p.doi)}">关系图 ↗</button></div>
          <div class="rel-list">${rels.map((r, i) => {
            const q = PAPERS[r[0]];
            if (!q) return '';
            const weak = r[3] === 1;
            const edge = r[2] ? `<span class="re">${esc(r[2].replace(/\|/g, '、'))}</span>` : '';
            return `<div class="rel-item${i >= 6 ? ' rm' : ''}" data-goto="${esc(q.doi)}">
              <span class="rt" title="${esc(q.title)}">${esc(q.title)}</span>${edge}${weak ? '<span class="re weak">弱关联</span>' : ''}
              <span class="rs">${weak ? '≈' : ''}${Math.round(r[1] * 100)}%</span></div>`;
          }).join('')}</div>
          ${rels.length > 6 ? `<button class="rel-more">展开全部 ${rels.length} 篇 ▾</button>` : ''}
        </div>` : '';
    return `<article class="card${p.high_impact?' is-hi':''}${favOn ? ' is-fav' : ''}" data-doi="${esc(p.doi)}">
      <div class="card-top">
        <span class="journal" title="${esc(p.journal)}">${esc(p.journal || '未知期刊')}</span>
        ${hi}${rev}
        ${tools}
      </div>
      <h3><a href="${esc(p.url)}" target="_blank" rel="noopener">${hl(p.title)}</a></h3>
      ${sum}
      <div class="card-tags">${tags.join('')}</div>
      <div class="card-foot">
        <span class="authors" title="${esc(p.authors)}">${authorsHTML(p)}</span>
        <button class="foot-btn bib-btn" data-bib="${esc(p.doi)}" title="复制这篇的 BibTeX">BibTeX</button>
        ${relBtn}
        <button class="foot-btn abs-btn"><span class="ar">▶</span>英文摘要</button>
        <a class="foot-btn" href="${esc(p.url)}" target="_blank" rel="noopener">DOI ↗</a>
      </div>
      ${relPanel}
      <div class="abstract"><span class="abs-loading">加载中…</span></div>
    </article>`;
  }

  let ABS = null, absPromise = null, ABS_FAILED = false;
  function loadAbs(){
    if (absPromise) return absPromise;
    absPromise = fetch('data/abstracts.json')
      .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
      .catch(() => { ABS_FAILED = true; return null; })
      .then(j => { ABS = j || {}; return ABS; });
    return absPromise;
  }

  function renderList(){
    const list = sortPapers(PAPERS.filter(p => matches(p, null)));
    const total = list.length;
    const shown = list.slice(0, state.limit);
    const searching = !!(state.q && state.hits);

    if (!total){
      $('#resultCount').textContent = '没有匹配的文献';
    } else if (searching){
      let line = `找到 <b>${total}</b> 篇<span class="qk">${state.qterms.map(t => `<i>${esc(t)}</i>`).join('')}</span>`;
      if (state.qwide) line += `<em class="qn">已放宽为部分关键词</em>`;
      else if (state.sort === 'rel') line += `<span style="color:var(--ink-4);font-size:.79rem">按相关度排序</span>`;
      if (state.sem){
        line += `<em class="qn sem" title="BM25 与向量余弦混合排序${state.semAdded ? `，语义补充 ${state.semAdded} 篇` : ''}">语义增强</em>`;
      }
      $('#resultCount').innerHTML = line;
      $('#resultCount').title = `BM25 · ${state.hits.size} 篇命中 · ${state.qused}/${state.qtotal} 个词项参与匹配 · ${state.qms.toFixed(1)} ms`;
    } else {
      $('#resultCount').innerHTML = `找到 <b>${total}</b> 篇${state.sort==='date'?' · 按日期倒序':''}`;
      $('#resultCount').title = '';
    }

    if (!total){
      const anySel = state.q || state.journals.size || DIMS.some(d => state.dims[d.key].size) || state.range !== 'all';
      const qShort = state.q.length > 22 ? state.q.slice(0, 22) + '…' : state.q;
      $('#list').innerHTML = `<div class="empty"><div class="ico">${state.q ? '🔍' : '🪸'}</div>
        <h2>${state.q ? `没有找到「${esc(qShort)}」` : (anySel ? '没有符合条件的论文' : '暂无文献数据')}</h2>
        <p>${state.q
          ? '换个更短的关键词，或把长句拆成两三个词分别搜；也可以直接用左侧标签筛选'
          : (anySel ? '试试放宽筛选条件，或清空全部筛选' : '等待下一次自动抓取')}</p>
        ${state.q ? '<button class="clear-all" id="clearSearch" style="margin-top:1rem">清空搜索</button>' : ''}</div>`;
      updateActive();
      return;
    }

    // 按日期分组
    const groups = [];
    shown.forEach(p => {
      const g = groups[groups.length-1];
      if (g && g.date === p.date) g.items.push(p);
      else groups.push({date:p.date, items:[p]});
    });
    // 当前筛选集下每天的真实总数（用于显示"共 N 篇"）
    const dayTotals = {};
    list.forEach(p => { dayTotals[p.date] = (dayTotals[p.date]||0)+1; });

    const out = groups.map(g => {
      const dt = parseDate(g.date);
      const label = `${dt.getMonth()+1} 月 ${dt.getDate()} 日`;
      const hot = {};
      g.items.forEach(p => (p.tags.theme||[]).forEach(id => { hot[id] = (hot[id]||0)+1; }));
      const hotTop = Object.keys(hot).sort((a,b)=>hot[b]-hot[a]).slice(0,3)
        .map(id => `<span>${esc((META['theme|'+id]||{}).zh || id)}</span>`).join('');
      return `<section class="day">
        <div class="day-head">
          <span class="day-date">${label}<span class="y">${dt.getFullYear()}</span></span>
          <span class="day-week">${WD[dt.getDay()]}</span>
          <span class="day-count">${dayTotals[g.date] || g.items.length} 篇</span>
          <span class="day-hot">${hotTop}</span>
        </div>
        ${g.items.map(cardHTML).join('')}
      </section>`;
    }).join('');

    const rest = total - shown.length;
    $('#list').innerHTML = out + (rest > 0
      ? `<button class="load-more" id="loadMore">加载更多<small>还有 ${rest} 篇</small></button>` : '');
    updateActive();
  }

  // ---------- 关系图 ----------
  function charW(ch, size){
    if (/[\u4e00-\u9fff\uff00-\uffef]/.test(ch)) return size;
    if (/[A-Za-z0-9]/.test(ch)) return size * 0.56;
    return size * 0.36;
  }
  function textW(s, size){ let w = 0; for (const ch of String(s||'')) w += charW(ch, size); return w; }

  // 切 token：中文单字、英文单词/数字整体，避免英文在词中间断开
  function splitTokens(s){
    const out = [];
    const re = /[\u4e00-\u9fff]|[A-Za-z0-9][A-Za-z0-9'’\-\.\/]*|[^\s]/g;
    let m;
    while ((m = re.exec(String(s || '').replace(/\s+/g, ' '))) !== null) out.push(m[0]);
    return out;
  }
  function joinTok(cur, tok){
    if (!cur) return tok;
    const sp = /[A-Za-z0-9,\.;:\)\]]$/.test(cur) && /^[A-Za-z0-9]/.test(tok);
    return cur + (sp ? ' ' : '') + tok;
  }
  function joinAll(toks){ let s = ''; for (const t of toks) s = joinTok(s, t); return s; }

  function fitOne(s, maxW, size){
    s = String(s || '').replace(/\s+/g, ' ').trim();
    if (textW(s, size) <= maxW) return s;
    const toks = splitTokens(s);
    while (toks.length && textW(joinAll(toks) + '…', size) > maxW) toks.pop();
    return joinAll(toks) + '…';
  }

  function splitLines(s, maxW, size, maxLines){
    const toks = splitTokens(String(s || '').replace(/\s+/g, ' ').trim());
    const lines = [];
    let cur = '', i = 0;
    while (i < toks.length){
      const cand = joinTok(cur, toks[i]);
      if (textW(cand, size) > maxW && cur){
        lines.push(cur);
        cur = '';
        if (lines.length >= maxLines - 1){
          const rest = toks.slice(i);
          while (rest.length && textW(joinAll(rest) + '…', size) > maxW) rest.pop();
          lines.push(joinAll(rest) + (i < toks.length ? '…' : ''));
          return lines;
        }
      } else { cur = cand; i++; }
    }
    if (cur) lines.push(cur);
    return lines;
  }

  const G = { VW: 460, VH: 800, stack: [] };

  function svgText(x, y, txt, size, cls, weight, anchor){
    return `<text x="${x}" y="${y}" text-anchor="${anchor || 'middle'}" dominant-baseline="central"
      font-size="${size}" font-weight="${weight || 500}" class="${cls}">${esc(txt)}</text>`;
  }

  function nodeSVG(cx, cy, w, h, title, sub, center, doi, tag, maxLines, fs){
    const size = center ? 12.8 : (fs || 12.5);
    const sm = +(10.5 * size / 12.5).toFixed(1);   // 标签/期刊行随主字号等比缩放
    const lines = splitLines(title, w - 28, size, maxLines || 2);
    const lh = size * 1.42;
    // 垂直分区：标签行(仅外围) / 标题块 / 期刊行
    const blockCy = cy + (tag ? 2 : -7);
    const startY = blockCy - (lines.length * lh) / 2 + lh / 2;
    let txt = '';
    if (tag) txt += svgText(cx, cy - h / 2 + 14, fitOne(tag, w - 28, sm), sm, 'ns', 500);
    txt += lines.map((ln, k) =>
      svgText(cx, startY + k * lh, ln, size, center ? 'ct' : 'nt', center ? 650 : 500)
    ).join('');
    if (sub) txt += svgText(cx, cy + h / 2 - 12, sub, sm, center ? 'cs' : 'ns', 400);
    const attrs = center ? '' : ` class="nd" data-node="${esc(doi)}" style="cursor:pointer"`;
    // 外围节点右上角加「直接看内容」角标：省掉「先换中心再查看」这一步
    const bx = cx + w / 2 - 15, by = cy - h / 2 + 15;
    const corner = center ? '' : `<g class="nvw" data-view="${esc(doi)}">
      <circle class="vb" cx="${bx.toFixed(1)}" cy="${by.toFixed(1)}" r="11"/>
      <path class="vi" d="M-3.4 3.4 L3.4 -3.4 M-0.4 -3.4 L3.4 -3.4 L3.4 0.4"
        transform="translate(${bx.toFixed(1)} ${by.toFixed(1)})" stroke-width="1.7"
        stroke-linecap="round" stroke-linejoin="round"/></g>`;
    return `<g${attrs}>
      <rect class="nbg${center ? ' cd' : ''}" x="${(cx - w / 2).toFixed(1)}" y="${(cy - h / 2).toFixed(1)}"
        width="${w}" height="${h}" rx="11" stroke-width="1"/>
      ${txt}${corner}</g>`;
  }

  const EDGE_LABEL_STYLE = 'paint-order:stroke;stroke:#ffffff;stroke-width:4px;stroke-linejoin:round';

  // 分层布局：按相关度从内到外填充，内环 = 最相关。
  // 不做「只要 4 篇」的数据截断，而是让画布随关联数扩到两环；
  // 超出画布容量的在图下明示「另有 N 篇见列表」，数据本身一篇不丢。
  const RINGS = [
    { R: 198, w: 164, h: 86, fs: 12.2, cap: 6 },    // 内环：强关联
    { R: 312, w: 152, h: 78, fs: 11.6, cap: 11 },   // 外环：次级关联
  ];
  const GRAPH_CAP = RINGS.reduce((s, r) => s + r.cap, 0);

  function radialSVG(p, rels){
    const one = rels.length <= 7;
    const W = one ? 900 : 880, H = one ? 600 : 720;
    const CX = W / 2, CY = H / 2 + (one ? 8 : 0);

    // 篇数少就单环（节点最大最清楚），多了再拆内外两环
    let plan;
    if (one){
      plan = [{ R: 226, w: 172, h: 90, fs: 12.5, from: 0, n: rels.length }];
    } else {
      const inner = Math.min(RINGS[0].cap, Math.ceil(rels.length / 2));
      plan = [
        { ...RINGS[0], from: 0, n: inner },
        { ...RINGS[1], from: inner, n: Math.max(0, rels.length - inner) },
      ].filter(x => x.n > 0);
    }

    const pos = [];
    plan.forEach((ring, ri) => {
      // 外环整体错开半格，免得连线正好从内环节点身上碾过去
      const start = -90 + (ri % 2 ? 180 / ring.n : 0);
      for (let k = 0; k < ring.n; k++){
        const ang = (start + k * 360 / ring.n) * Math.PI / 180;
        pos.push({
          x: CX + ring.R * Math.cos(ang),
          y: CY + ring.R * Math.sin(ang),
          ring, r: rels[ring.from + k],
        });
      }
    });

    const parts = [];
    pos.forEach(({ x, y, ring, r }) => {
      const dx = x - CX, dy = y - CY, len = Math.hypot(dx, dy) || 1;
      const bow = 22 + ring.R * 0.09;          // 半径越大弧越弯，避免压住内环节点
      const qx = (CX + x) / 2 - (dy / len) * bow;
      const qy = (CY + y) / 2 + (dx / len) * bow;
      parts.push(`<path class="eg${r.w ? ' weak' : ''}" d="M${CX} ${CY} Q${qx.toFixed(1)} ${qy.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}"
        stroke-width="${(0.9 + r.s * 2.2).toFixed(2)}" stroke-linecap="round"/>`);
    });

    pos.forEach(({ x, y, ring, r }) => {
      const tag = (r.t ? r.t + ' · ' : '') + (r.w ? '弱关联 ≈' : '') + Math.round(r.s * 100) + '%';
      parts.push(nodeSVG(x, y, ring.w, ring.h, r.q.title,
        fitOne(r.q.journal, ring.w - 30, ring.fs * 0.85), false, r.q.doi, tag, 2, ring.fs));
    });

    parts.push(nodeSVG(CX, CY, 220, 102, p.title, fitOne(p.journal, 186, 10.5), true, p.doi, '', 3));
    return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMid meet"
      xmlns="http://www.w3.org/2000/svg">${parts.join('')}</svg>`;
  }

  // 窄屏：竖排树状，避免径向图缩放后字号过小
  function verticalSVG(p, rels){
    const W = G.VW;
    const HEAD_Y = 16, HEAD_H = 98, TRUNK_X = 50;
    const ROW_TOP = 150, ROW_H = 122, ROW_GAP = 34;
    const NODE_X = 74, NODE_W = W - NODE_X - 22;
    const rows = rels.length || 1;
    const H = ROW_TOP + rows * (ROW_H + ROW_GAP) - ROW_GAP + 26;
    const parts = [];

    const lastCY = ROW_TOP + (rows - 1) * (ROW_H + ROW_GAP) + ROW_H / 2;
    parts.push(`<path class="eg" d="M${TRUNK_X} ${HEAD_Y + HEAD_H} L${TRUNK_X} ${lastCY}"
      stroke-width="1.6" stroke-linecap="round"/>`);

    rels.forEach((r, k) => {
      const y = ROW_TOP + k * (ROW_H + ROW_GAP);
      const cy = y + ROW_H / 2;
      parts.push(`<path class="eg${r.w ? ' weak' : ''}" d="M${TRUNK_X} ${cy} L${NODE_X} ${cy}"
        stroke-width="${(0.9 + r.s * 2).toFixed(2)}" stroke-linecap="round"/>`);
      parts.push(`<circle class="ed" cx="${TRUNK_X}" cy="${cy}" r="3"/>`);

      // 节点内：共享标签 + 分数在最上一行，标题两行，期刊在最下
      const size = 20.5;
      const lines = splitLines(r.q.title, NODE_W - 34, size, 2);
      const tagTxt = (r.t ? r.t + ' · ' : '') + (r.w ? '弱关联 ≈' : '') + Math.round(r.s * 100) + '%';
      let inner = svgText(NODE_X + NODE_W / 2, y + 21, fitOne(tagTxt, NODE_W - 34, 13), 13, 'ns', 500);
      const lh = size * 1.34;
      const startY = cy - 6 - ((lines.length - 1) * lh) / 2;
      inner += lines.map((ln, i) =>
        svgText(NODE_X + NODE_W / 2, startY + i * lh, ln, size, 'nt', 500)).join('');
      inner += svgText(NODE_X + NODE_W / 2, y + ROW_H - 17,
        fitOne(r.q.journal, NODE_W - 34, 13), 13, 'ns', 400);

      const vx = NODE_X + NODE_W - 28, vy = y + 22;
      const vbtn = `<g class="nvw" data-view="${esc(r.q.doi)}">
        <circle class="vb" cx="${vx}" cy="${vy}" r="14"/>
        <path class="vi" d="M-3.4 3.4 L3.4 -3.4 M-0.4 -3.4 L3.4 -3.4 L3.4 0.4"
          transform="translate(${vx} ${vy}) scale(1.3)" stroke-width="1.2"
          stroke-linecap="round" stroke-linejoin="round"/></g>`;
      parts.push(`<g class="nd" data-node="${esc(r.q.doi)}" style="cursor:pointer">
        <rect class="nbg" x="${NODE_X}" y="${y}" width="${NODE_W}" height="${ROW_H}" rx="12"
          stroke-width="1"/>${inner}${vbtn}</g>`);
    });

    const hLines = splitLines(p.title, W - 72, 18, 2);
    const hLh = 24;
    const hBlockCy = HEAD_Y + 36;
    const hStart = hBlockCy - ((hLines.length - 1) * hLh) / 2;
    let headTxt = hLines.map((ln, i) => svgText(W / 2, hStart + i * hLh, ln, 18, 'ct', 650)).join('');
    headTxt += svgText(W / 2, HEAD_Y + HEAD_H - 20, fitOne(p.journal, W - 72, 12), 12, 'cs', 400);
    parts.push(`<g>
      <rect class="nbg cd" x="22" y="${HEAD_Y}" width="${W - 44}" height="${HEAD_H}" rx="12"
        stroke-width="1"/>${headTxt}</g>`);

    return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="xMidYMin meet"
      xmlns="http://www.w3.org/2000/svg">${parts.join('')}</svg>`;
  }

  function drawGraph(doi){
    const p = BY_DOI[doi];
    if (!p) return;
    const all = (p.rel || [])
      .map(r => ({ q: PAPERS[r[0]], s: r[1], t: (r[2] || '').replace(/\|/g, '、'), w: r[3] === 1 }))
      .filter(x => x.q && x.q.doi !== doi)
      .sort((a, b) => b.s - a.s);

    const narrow = window.innerWidth < 680;
    const rels = all.slice(0, narrow ? 16 : GRAPH_CAP);
    const more = all.length - rels.length;

    $('#relTitle').textContent = p.title;
    $('#relTitle').title = p.title;
    // 窄屏底部提示被隐藏，篇数说明改挂到标题栏
    $('#relDepth').textContent = all.length
      ? (narrow && more > 0 ? `${all.length} 篇 · 图内 ${rels.length}` : `${all.length} 篇关联`)
      : '无关联';
    $('#relBack').style.display = G.stack.length > 1 ? '' : 'none';
    $('#raCard').dataset.doi = doi;
    $('#raLink').href = p.url || ('https://doi.org/' + encodeURIComponent(doi));
    $('#relHint').textContent = more > 0
      ? `图内为相关度最高的 ${rels.length} 篇，另有 ${more} 篇可在卡片列表查看`
      : '点节点换中心，点右上角 ⤢ 直接看内容';

    const canvas = $('#relCanvas');
    canvas.classList.toggle('narrow', narrow);
    canvas.innerHTML = narrow ? verticalSVG(p, rels) : radialSVG(p, rels);
    canvas.dataset.doi = doi;
    canvas.scrollTop = 0;
  }

  function openGraph(doi){
    G.stack = [doi];
    drawGraph(doi);
    $('#relModal').classList.add('show');
    document.body.style.overflow = 'hidden';
  }
  function closeGraph(){
    $('#relModal').classList.remove('show');
    document.body.style.overflow = '';
    G.stack = [];
  }

  let resizeT = null;
  window.addEventListener('resize', () => {
    const c = $('#relCanvas');
    if (!$('#relModal').classList.contains('show') || !c.dataset.doi) return;
    clearTimeout(resizeT);
    resizeT = setTimeout(() => drawGraph(c.dataset.doi), 180);
  });

  function findCard(doi){
    return document.querySelector(`.card[data-doi="${CSS.escape(doi)}"]`);
  }

  // 在当前已渲染范围内查找；找不到就逐步扩大渲染条数
  function locateCard(doi){
    let el = findCard(doi);
    while (!el && state.limit < PAPERS.length){
      state.limit = Math.min(state.limit + 60, PAPERS.length);
      renderList();
      el = findCard(doi);
    }
    return el;
  }

  function gotoPaper(doi){
    if (!BY_DOI[doi]) return;
    let el = locateCard(doi);
    if (!el){
      // 目标被当前筛选条件排除：清空条件后重试
      setQuery('');
      const sb = $('#search'); if (sb) sb.value = '';
      state.journals.clear();
      DIMS.forEach(d => state.dims[d.key].clear());
      state.range = 'all';
      document.querySelectorAll('#rangeSeg button').forEach(b => b.classList.toggle('on', b.dataset.range === 'all'));
      state.limit = 60;
      renderList();
      el = locateCard(doi);
    }
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('target');
    clearTimeout(el._hl);
    el._hl = setTimeout(() => el.classList.remove('target'), 2600);
  }

  // 从关系图跳到正文卡片：关闭图层 → 定位卡片 → 展开摘要
  function viewPaper(doi){
    if (!BY_DOI[doi]) return;
    closeGraph();
    // 等 body 的 overflow 恢复并完成一次布局再滚动，否则 scrollIntoView 会被锁住
    setTimeout(() => {
      gotoPaper(doi);
      const el = findCard(doi);       // gotoPaper 可能重建列表，必须重新取
      if (!el) return;
      const sum = el.querySelector('.summary');
      if (sum) sum.classList.add('open');
      else {
        // 没有中文速览的论文，直接展开英文摘要，否则跳过来只能看到标题
        const box = el.querySelector('.abstract');
        const ab = el.querySelector('.abs-btn');
        if (ab && box && !box.classList.contains('show')) ab.click();
      }
    }, 60);
  }

  // ---------- 已选条 ----------
  function updateActive(){
    const items = [];
    DIMS.forEach(d => state.dims[d.key].forEach(id => items.push({dim:d.key, id, zh:(META[d.key+'|'+id]||{zh:id}).zh})));
    state.journals.forEach(j => items.push({dim:'journal', id:j, zh:j}));
    const bar = $('#activeBar');
    if (!items.length){ bar.classList.remove('show'); }
    else {
      bar.classList.add('show');
      $('#activeChips').innerHTML = items.map(it =>
        `<button class="chip on" data-dim="${it.dim}" data-id="${esc(it.id)}" data-unset="1">
          <span class="zh">${esc(it.zh)}</span><span class="n">×</span></button>`).join('');
    }
    const n = items.length;
    $('#fabCnt').textContent = n;
    $('#fabCnt').style.display = n ? '' : 'none';
  }

  // ---------- 弹层通用 ----------
  function openModal(id){
    $('#' + id).classList.add('show');
    document.body.style.overflow = 'hidden';
  }
  function closeModal(id){
    $('#' + id).classList.remove('show');
    if (!document.querySelector('.modal.show, .rel-modal.show')) document.body.style.overflow = '';
  }

  // ---------- 批量选择 ----------
  function syncSel(){
    const n = state.sel.size;
    $('#bulkN').textContent = `已选 ${n} 篇`;
    $('#bulkBar').classList.toggle('show', n > 0);
    document.querySelectorAll('.sel-box').forEach(b => {
      b.classList.toggle('on', state.sel.has(b.dataset.sel));
    });
  }

  // ---------- 作者聚合 ----------
  function openAuthor(name){
    const list = PAPERS.filter(p => !p.off_topic &&
      (p.authors || '').split(';').map(s => s.trim()).includes(name));
    list.sort((a, b) => (b.date > a.date ? 1 : -1));
    $('#auTitle').textContent = name;
    $('#auTitle').title = name;
    $('#auCount').textContent = `${list.length} 篇`;
    if (!list.length){
      $('#auBody').innerHTML = `<div class="ask-empty">站内暂时没有 ${esc(name)} 的其他论文</div>`;
      openModal('auModal'); return;
    }
    const years = {};
    list.forEach(p => { const y = (p.date || '').slice(0, 4); years[y] = (years[y] || 0) + 1; });
    const meta = Object.keys(years).sort().reverse()
      .map(y => `${y} 年 ${years[y]} 篇`).join(' · ');
    $('#auBody').innerHTML = `<div class="au-head"><span class="au-meta">${esc(meta)}</span></div>
      <div class="au-list">${list.map(p => `
        <div class="rel-item" data-goto="${esc(p.doi)}">
          <span class="rt" title="${esc(p.title)}">${esc(p.title)}</span>
          <span class="re">${esc(p.journal || '—')}</span>
          <span class="rs">${esc(p.date.slice(5))}</span>
        </div>`).join('')}</div>`;
    openModal('auModal');
  }

  // ---------- 趋势 ----------
  const TREND_PAL = ['#0e7c72', '#c65433', '#4a56c4', '#9a6a10', '#2f8f9d', '#8b5c9e', '#4d7c2f', '#b8446f'];
  // 深色背景下要整体提亮，否则深青、砖红会糊进背景
  const TREND_PAL_DARK = ['#4fd1c0', '#f0906f', '#9aa5f5', '#e0b45c', '#5ec9d8', '#c48fd8', '#8fc46a', '#f07aa0'];
  const trendPal = () => document.documentElement.getAttribute('data-theme') === 'dark'
    ? TREND_PAL_DARK : TREND_PAL;
  const TREND_DIMS = { theme: '研究主题', species: '研究鱼种', journal: '期刊' };
  let trendDim = 'theme';
  const trendOff = new Set();
  const TREND_MAX_DAYS = 45;

  function ymd(d){
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }

  // 窗口跟着数据走：库里名义上跨 100 天，但 11/2 之前只有零散补录。
  // 从今天往前逐日看，连续 3 天空档就停，避免把「一天一篇」的稀疏历史画成断崖
  function trendDays(){
    const have = new Set();
    PAPERS.forEach(p => { if (!p.off_topic && p.date) have.add(p.date); });
    let last = 0;
    for (let i = 0; i < TREND_MAX_DAYS; i++){
      const d = new Date(ANCHOR.getFullYear(), ANCHOR.getMonth(), ANCHOR.getDate() - i);
      if (have.has(ymd(d))) last = i + 1;
      else if (last && i + 1 - last >= 3) break;
    }
    return Math.max(7, Math.min(TREND_MAX_DAYS, last || 7));
  }

  function renderTrend(){
    $('#trendTabs').innerHTML = Object.keys(TREND_DIMS).map(k =>
      `<button class="trend-tab${k === trendDim ? ' on' : ''}" data-tdim="${k}">${TREND_DIMS[k]}</button>`).join('');

    const nDays = trendDays();
    const days = [];
    for (let i = nDays - 1; i >= 0; i--){
      const d = new Date(ANCHOR.getFullYear(), ANCHOR.getMonth(), ANCHOR.getDate() - i);
      days.push({ key: ymd(d), label: `${d.getMonth() + 1}/${d.getDate()}` });
    }
    const idxOf = {};
    days.forEach((x, i) => { idxOf[x.key] = i; });

    const counts = new Map();
    PAPERS.forEach(p => {
      if (p.off_topic) return;
      const i = idxOf[p.date];
      if (i === undefined) return;
      const keys = trendDim === 'journal'
        ? [(p.journal || '').trim()]
        : (p.tags[trendDim] || []).map(id => {
            const m = META[trendDim + '|' + id]; return m ? m.zh : id;
          });
      keys.forEach(k => {
        if (!k) return;
        let arr = counts.get(k);
        if (!arr){ arr = new Array(days.length).fill(0); counts.set(k, arr); }
        arr[i] += 1;
      });
    });

    const rows = [...counts.entries()]
      .map(([k, arr]) => ({ k, arr, total: arr.reduce((a, b) => a + b, 0) }))
      .sort((a, b) => b.total - a.total)
      .slice(0, 8);

    const W = 820, H = 330, PL = 42, PR = 14, PT = 14, PB = 36;
    const rawMax = Math.max(1, ...rows.flatMap(r => r.arr));
    const step = rawMax <= 5 ? 1 : rawMax <= 12 ? 2 : rawMax <= 30 ? 5 : rawMax <= 60 ? 10 : 20;
    const ymax = Math.max(step, Math.ceil(rawMax / step) * step);
    const X = i => PL + (W - PL - PR) * (days.length === 1 ? 0.5 : i / (days.length - 1));
    const Y = v => PT + (H - PT - PB) * (1 - v / ymax);

    const parts = [];
    for (let v = 0; v <= ymax; v += step){
      parts.push(`<line class="gl" x1="${PL}" y1="${Y(v).toFixed(1)}" x2="${W - PR}" y2="${Y(v).toFixed(1)}"/>`);
      parts.push(`<text class="lb" x="${PL - 8}" y="${(Y(v) + 3.5).toFixed(1)}" text-anchor="end">${v}</text>`);
    }
    const every = Math.max(1, Math.ceil(days.length / 6));
    days.forEach((d, i) => {
      if (i % every !== 0 && i !== days.length - 1) return;
      parts.push(`<text class="lb" x="${X(i).toFixed(1)}" y="${H - PB + 18}" text-anchor="middle">${d.label}</text>`);
    });

    const PAL = trendPal();
    rows.forEach((r, ri) => {
      if (trendOff.has(r.k)) return;
      const color = PAL[ri % PAL.length];
      const d = r.arr.map((v, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(v).toFixed(1)}`).join(' ');
      parts.push(`<path class="ln" stroke="${color}" d="${d}" stroke-width="${days.length > 20 ? 1.9 : 2.4}"/>`);
      parts.push(r.arr.map((v, i) =>
        `<circle class="pt" cx="${X(i).toFixed(1)}" cy="${Y(v).toFixed(1)}" r="${days.length > 20 ? 2.1 : 2.9}" fill="${color}">
          <title>${esc(r.k)} · ${days[i].label} 当日 ${v} 篇</title></circle>`).join(''));
    });

    $('#trendChart').innerHTML = `<svg class="trend-svg" viewBox="0 0 ${W} ${H}"
      preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">${parts.join('')}</svg>`;

    $('#trendLegend').innerHTML = rows.map((r, ri) => {
      const color = PAL[ri % PAL.length];
      return `<button class="${trendOff.has(r.k) ? 'off' : ''}" data-tkey="${esc(r.k)}">
        <i style="background:${color}"></i>${esc(r.k.length > 18 ? r.k.slice(0, 17) + '…' : r.k)}<b>${r.total} 篇</b></button>`;
    }).join('');

    $('#trendSub').textContent = `${rows.length} 条线 · ${days[0].label}–${days[days.length - 1].label}`;
    $('#trendNote').textContent =
      `按日统计最近 ${nDays} 天（数据连续区间，之前的零散补录不计）。纵轴是当天新增论文数，` +
      `曲线整体抬升或持续居高的方向更可能在升温；单日尖峰多是抓取批次差异，看三五天的走势更靠谱。` +
      `点图例可隐藏某条线。样本 ${PAPERS.length} 篇，量小时波动大，结论别太当真。`;
  }

  // ---------- 问答（RAG） ----------
  const ASK_HINTS = [
    '这周有什么值得关注的新方向',
    '深水网箱养殖的病害研究进展',
    '气候变化对渔业资源有什么影响',
    '有没有关于大黄鱼的研究',
    'eDNA 怎么用于鱼类监测',
  ];
  let asking = false;
  let lastAskDocs = [];

  // 用户自己的 DeepSeek Key：只存本机 localStorage，随请求发出去一次，不落任何文件
  const ASK_KEY_LS = 'fd-dk';
  function userKey(){
    try { return (localStorage.getItem(ASK_KEY_LS) || '').trim(); } catch (_) { return ''; }
  }
  function syncKeyUI(){
    const has = !!userKey();
    const note = $('#askKeyNote');
    if (!note) return;
    note.className = 'ask-key-note' + (has ? ' ok' : '');
    note.textContent = has
      ? '已保存一个 Key（只在这台设备），提问时会带上。点「清除」可移除。'
      : '只存在这台设备的浏览器里，随提问一起发给你的 Vercel 函数、再转发给 DeepSeek。' +
        '不写进网页文件，别人打开这个站看不到你的 Key。换设备需要重新填。';
    const inp = $('#askKeyIn');
    if (inp) inp.value = '';
    if (inp) inp.placeholder = has ? '已保存（重新粘贴可覆盖）' : 'sk-…';
  }
  function saveUserKey(){
    const inp = $('#askKeyIn');
    const v = (inp.value || '').trim();
    if (!v){
      $('#askKeyNote').textContent = '还没填内容。DeepSeek 的 Key 是 sk- 开头的一长串。';
      return;
    }
    if (v.length < 20){
      $('#askKeyNote').textContent = '这个长度看着不像 Key（DeepSeek 的通常在 30 位以上），检查是不是只复制了一半。';
      return;
    }
    try { localStorage.setItem(ASK_KEY_LS, v); } catch (_) {
      $('#askKeyNote').textContent = '浏览器不让存（可能是隐私模式），换普通窗口再试。';
      return;
    }
    syncKeyUI();
  }
  function clearUserKey(){
    try { localStorage.removeItem(ASK_KEY_LS); } catch (_) {}
    syncKeyUI();
  }

  async function recallDocs(q, k){
    // 优先语义召回：问题往往不含原文关键词，向量更稳
    if (EMB.api){
      try {
        await loadEmb();
        if (EMB.ready){
          const sem = await semanticScores(q);
          const top = [...sem.entries()]
            .filter(([doi, s]) => BY_DOI[doi] && s >= 0.28)
            .sort((a, b) => b[1] - a[1]).slice(0, k)
            .map(([doi, s]) => ({ p: BY_DOI[doi], s }));
          if (top.length >= 3) return { docs: top, how: 'semantic' };
        }
      } catch (e){ /* 熔断/超时，退到关键词 */ }
    }
    const r = BM25.search(q);
    const docs = [];
    if (r && r.hits.size){
      const max = Math.max(...r.hits.values()) || 1;
      [...r.hits.entries()].sort((a, b) => b[1] - a[1]).slice(0, k)
        .forEach(([doi, s]) => { if (BY_DOI[doi]) docs.push({ p: BY_DOI[doi], s: s / max }); });
    }
    // 长问句在 BM25 下常常只命中一两篇（要求全部词项覆盖），再用「命中词数」补几位
    if (docs.length < 6){
      const terms = [...new Set(tokenize(q))].filter(t => t.length >= 2).slice(0, 12);
      const seen = new Set(docs.map(d => d.p.doi));
      const extra = [];
      PAPERS.forEach(p => {
        if (p.off_topic || seen.has(p.doi)) return;
        let hit = 0;
        for (const t of terms) if (p._text.indexOf(t) >= 0) hit += 1;
        if (hit >= 2) extra.push({ p, hit });
      });
      extra.sort((a, b) => b.hit - a.hit);
      extra.slice(0, 6 - docs.length).forEach(x => docs.push({ p: x.p, s: 0.05 }));
    }
    return { docs, how: docs.length ? 'bm25' : 'none' };
  }

  function renderAskDocs(docs){
    return `<div class="ask-docs"><div class="h">本次依据（${docs.length} 篇）</div>
      ${docs.map((d, i) => `<div class="ask-doc" data-askdoc="${i}">
        <span class="n">${i + 1}</span>
        <span class="tx" title="${esc(d.p.title)}">${esc(d.p.title)}</span>
        <span class="re" style="font-size:.68rem;color:var(--ink-4);flex:none">${esc(d.p.journal || '')}</span>
      </div>`).join('')}</div>`;
  }

  function answerHTML(text, docs){
    return esc(text).replace(/\[(\d{1,2})\]/g, (m, n) => {
      const i = +n;
      if (i < 1 || i > docs.length) return m;
      return `<span class="ct" data-askdoc="${i - 1}">${i}</span>`;
    });
  }

  async function runAsk(raw){
    const q = String(raw || '').trim();
    if (!q || asking) return;
    asking = true;
    $('#askSend').disabled = true;
    $('#askState').textContent = '召回中…';
    const out = $('#askOut');
    out.innerHTML = `<div class="ask-loading"><span class="spin"></span>正在从 ${PAPERS.length} 篇文献里找依据…</div>`;

    let docs = [];
    let how = 'none';
    try {
      const rec = await recallDocs(q, 8);
      docs = rec.docs; how = rec.how;
      if (!docs.length){
        out.innerHTML = `<div class="ask-empty">没有召回到相关文献。<br>换个说法，或用左侧标签 / 搜索框先缩小范围。</div>`;
        $('#askState').textContent = '';
        return;
      }
      lastAskDocs = docs;

      if (!ASK_API){
        out.innerHTML = `<div class="ask-empty" style="text-align:left">
          站内召回已经完成，但生成接口还没配置，所以只给依据不给答案。<br>
          <span style="font-size:.78rem;opacity:.8">在 Vercel 给这个项目加 DEEPSEEK_API_KEY，并把 /api/ask 填进 ASK_ENDPOINT 即可开启。</span>
        </div>` + renderAskDocs(docs);
        $('#askState').textContent = how === 'semantic' ? '语义召回' : '关键词召回';
        return;
      }

      $('#askState').textContent = '生成中…';
      out.innerHTML = `<div class="ask-loading"><span class="spin"></span>已找到 ${docs.length} 篇依据，正在生成回答…</div>`;

      const ctl = new AbortController();
      const timer = setTimeout(() => ctl.abort(), 50000);
      let r;
      try {
        r = await fetch(ASK_API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            q,
            k: userKey(),        // 服务端有变量时会被忽略；没有才用这个
            docs: docs.map(d => ({
              t: d.p.title, s: d.p.summary, j: d.p.journal, d: d.p.date, u: d.p.url,
            })),
          }),
          signal: ctl.signal,
        });
      } finally { clearTimeout(timer); }

      if (!r.ok){
        const detail = await r.text().catch(() => '');
        let code = '', hint = `生成服务返回 ${r.status}`;
        try {
          const j = JSON.parse(detail);
          if (j.error) code = j.error;
          if (j.code) code = code || j.code;
          if (j.hint) hint = j.hint;
          else if (j.error) hint = '';
        } catch (e){}

        // 环境变量相关问题单独给可执行的说法，不然「missing_key」根本没法定位
        let lead = '没能生成回答：';
        let tail = '依据已经找好了，可以直接看下面这几篇。';
        if (code === 'missing_key'){
          lead = '还没接上大模型：服务端没读到 Key，你也没在页面里填自己的。';
          tail = '已经帮你打开了上方的 Key 输入框，粘贴保存后直接重新提问即可（只存本机）；' +
                 '想一劳永逸就去 Vercel 配 DEEPSEEK_API_KEY。依据已经找好了，可以先看。';
          const kb = $('#askKeyBox');
          if (kb){ kb.open = true; }
          const ki = $('#askKeyIn');
          if (ki) ki.focus();
        } else if (code === 'upstream_auth'){
          lead = 'DEEPSEEK_API_KEY 被上游拒绝了：';
          tail = '多半是 key 填错、复制时带了空格，或余额不足。';
        } else if (code === 'upstream_error'){
          lead = '大模型服务报错：';
          tail = '稍等再试一次；依据不受影响。';
        } else if (code === 'rate_limited' || code === 'daily_budget_exhausted'){
          lead = '今天的提问额度用完了：';
          tail = '明天再来，或先直接看依据。';
        }
        const known = { missing_key:1, upstream_auth:1, upstream_error:1, rate_limited:1, daily_budget_exhausted:1 };
        const hintTxt = (hint && !known[code])
          ? `<br><span style="font-size:.78rem;opacity:.85">${esc(hint)}</span>` : '';
        out.innerHTML = `<div class="ask-empty" style="text-align:left">
          ${esc(lead)}${hintTxt}<br>
          <span style="font-size:.78rem;opacity:.8">${esc(tail)}</span>
        </div>` + renderAskDocs(docs);
        $('#askState').textContent = '降级';
        return;
      }

      const j = await r.json();
      out.innerHTML = `<div class="ask-ans">${answerHTML(j.a || '', docs)}</div>` + renderAskDocs(docs);
      $('#askState').textContent = (how === 'semantic' ? '语义召回' : '关键词召回') +
        (j.usage && j.usage.total_tokens ? ` · ${j.usage.total_tokens} tok` : '');
    } catch (e){
      const aborted = e && e.name === 'AbortError';
      out.innerHTML = `<div class="ask-empty" style="text-align:left">
        ${aborted ? '等太久了，请求已取消' : '生成服务没连上（跨域被拦或网络不通）'}${docs.length ? '，但依据已经找好了：' : ''}
        <br><span style="font-size:.78rem;opacity:.8">${aborted ? '问句太长或文献太多时可以再试一次。' : '可以直接看下面这几篇，或用搜索框。'}</span>
      </div>` + (docs.length ? renderAskDocs(docs) : '');
      $('#askState').textContent = docs.length ? '降级' : '';
    } finally {
      asking = false;
      $('#askSend').disabled = false;
    }
  }

  function refresh(){ state.limit = 60; renderSide(); renderList(); }

  // ---------- 交互 ----------
  document.addEventListener('click', e => {
    const chip = e.target.closest('.chip');
    if (chip && chip.dataset.dim){
      const {dim, id} = chip.dataset;
      if (chip.dataset.unset){ // 从已选条移除
        (dim === 'journal' ? state.journals : state.dims[dim]).delete(id);
      } else if (dim === 'journal'){
        state.journals.has(id) ? state.journals.delete(id) : state.journals.add(id);
      } else {
        const s = state.dims[dim];
        s.has(id) ? s.delete(id) : s.add(id);
      }
      refresh(); return;
    }
    const tg = e.target.closest('.tg');
    if (tg && tg.dataset.dim){
      const {dim, id} = tg.dataset;
      if (dim === 'journal') state.journals.add(id); else state.dims[dim].add(id);
      refresh(); window.scrollTo({top:0, behavior:'smooth'}); return;
    }
    const more = e.target.closest('[data-more]');
    if (more){
      const k = more.dataset.more; expanded[k] = !expanded[k]; renderSide(); return;
    }
    const reset = e.target.closest('[data-reset]');
    if (reset){
      const k = reset.dataset.reset;
      if (k === 'journal') state.journals.clear(); else state.dims[k].clear();
      refresh(); return;
    }
    if (e.target.closest('#clearAll') || e.target.closest('#clearSide') || e.target.closest('#clearSearch')){
      setQuery(''); $('#search').value = '';
      state.journals.clear(); DIMS.forEach(d => state.dims[d.key].clear());
      state.range = 'all';
      document.querySelectorAll('#rangeSeg button').forEach(b => b.classList.toggle('on', b.dataset.range === 'all'));
      refresh(); return;
    }
    const lm = e.target.closest('#loadMore');
    if (lm){ state.limit += 60; renderList(); return; }

    // 收藏 / 勾选 / BibTeX / 作者 / 弹层开关
    const fav = e.target.closest('[data-fav]');
    if (fav){
      const doi = fav.dataset.fav;
      FAV.has(doi) ? FAV.delete(doi) : FAV.add(doi);
      saveFav();
      const on = FAV.has(doi);
      fav.textContent = on ? '★' : '☆';
      fav.classList.toggle('on', on);
      fav.title = on ? '取消收藏' : '收藏（存本地，可导出 BibTeX）';
      const card = fav.closest('.card');
      if (card) card.classList.toggle('is-fav', on);
      if (state.favOnly && !on) renderList();
      return;
    }
    const selBox = e.target.closest('[data-sel]');
    if (selBox){
      const doi = selBox.dataset.sel;
      state.sel.has(doi) ? state.sel.delete(doi) : state.sel.add(doi);
      syncSel(); return;
    }
    const bib = e.target.closest('[data-bib]');
    if (bib){ const bp = BY_DOI[bib.dataset.bib]; if (bp) copyBib([bp]); return; }
    const al = e.target.closest('[data-author]');
    if (al){ openAuthor(al.dataset.author); return; }
    const cl = e.target.closest('[data-close]');
    if (cl){ closeModal(cl.dataset.close); return; }

    // 批量条
    if (e.target.closest('#bulkBib')){
      const picked = PAPERS.filter(p => state.sel.has(p.doi));
      if (picked.length) copyBib(picked);
      return;
    }
    if (e.target.closest('#bulkFav')){
      let add = 0;
      state.sel.forEach(d => { if (!FAV.has(d)){ FAV.add(d); add += 1; } });
      saveFav(); syncSel(); renderList();
      toast(add ? `已收藏 ${add} 篇` : '这些都已经在收藏里了');
      return;
    }
    if (e.target.closest('#bulkClear')){
      state.sel.clear(); syncSel(); renderList(); return;
    }

    // 顶部入口
    if (e.target.closest('#askBtn')){ openModal('askModal'); $('#askQ').focus(); return; }
    if (e.target.closest('#trendBtn')){ renderTrend(); openModal('trendModal'); return; }
    if (e.target.closest('#subBtn')){ openModal('subModal'); return; }
    if (e.target.closest('#favBtn')){
      state.favOnly = !state.favOnly;
      $('#favBtn').classList.toggle('on', state.favOnly);
      if (state.favOnly && !FAV.size) toast('还没有收藏，点卡片右上角的 ☆ 试试');
      refresh(); return;
    }

    // 趋势交互
    const tdim = e.target.closest('[data-tdim]');
    if (tdim){ trendDim = tdim.dataset.tdim; trendOff.clear(); renderTrend(); return; }
    const tkey = e.target.closest('[data-tkey]');
    if (tkey){
      const k = tkey.dataset.tkey;
      trendOff.has(k) ? trendOff.delete(k) : trendOff.add(k);
      renderTrend(); return;
    }

    // 问答：点引用编号 / 依据条目 → 跳到那篇
    const adoc = e.target.closest('[data-askdoc]');
    if (adoc && lastAskDocs.length){
      const d = lastAskDocs[+adoc.dataset.askdoc];
      if (d){ closeModal('askModal'); gotoPaper(d.p.doi); }
      return;
    }

    // 订阅复制
    if (e.target.closest('#subCopy')){
      copyText(FEED_URL).then(() => toast('RSS 地址已复制'))
        .catch(() => toast('复制受限，请手动选中地址'));
      return;
    }

    // 相关文献展开
    const rbtn = e.target.closest('.rel-btn');
    if (rbtn){
      const card = rbtn.closest('.card');
      const panel = card.querySelector('.rel-panel');
      const on = !panel.classList.contains('show');
      panel.classList.toggle('show', on);
      rbtn.classList.toggle('open', on);
      return;
    }
    const gbtn = e.target.closest('.rel-graph-btn');
    if (gbtn && gbtn.dataset.graph){ openGraph(gbtn.dataset.graph); return; }
    const rmore = e.target.closest('.rel-more');
    if (rmore){
      const panel = rmore.closest('.rel-panel');
      const on = !panel.classList.contains('more');
      panel.classList.toggle('more', on);
      rmore.textContent = on ? '收起 ▴'
        : `展开全部 ${panel.querySelectorAll('.rel-item').length} 篇 ▾`;
      return;
    }
    const ritem = e.target.closest('.rel-item');
    if (ritem && ritem.dataset.goto){
      if ($('#auModal').classList.contains('show')) closeModal('auModal');
      gotoPaper(ritem.dataset.goto); return;
    }

    // 摘要展开
    const btn = e.target.closest('.abs-btn');
    if (btn){
      const card = btn.closest('.card');
      const box = card.querySelector('.abstract');
      const doi = card.dataset.doi;
      const opening = !box.classList.contains('show');
      box.classList.toggle('show', opening);
      btn.classList.toggle('open', opening);
      if (opening && box.dataset.filled !== '1'){
        const p = PAPERS.find(x => x.doi === doi);
        const local = p && p.abstract;
        if (local){ box.textContent = local; box.dataset.filled = '1'; }
        else loadAbs().then(map => {
          const txt = (map && map[doi]) || '';
          box.innerHTML = ABS_FAILED
            ? '<span class="abs-loading">摘要文件未能加载：请通过 HTTP 访问（cd docs && python -m http.server）</span>'
            : (txt ? esc(txt) : '<span class="abs-loading">暂无英文摘要（出版商未提供）</span>');
          box.dataset.filled = '1';
        });
      }
      return;
    }
    const seg = e.target.closest('#rangeSeg button');
    if (seg){
      state.range = seg.dataset.range;
      document.querySelectorAll('#rangeSeg button').forEach(b => b.classList.toggle('on', b === seg));
      refresh(); return;
    }
  });

  let t = null, composing = false;
  function runQuery(v){
    setQuery(v);
    state.limit = 60;
    renderSide();
    renderList();
  }
  $('#search').addEventListener('compositionstart', () => { composing = true; });
  $('#search').addEventListener('compositionend', e => {
    composing = false;
    clearTimeout(t);
    t = setTimeout(() => runQuery(e.target.value), 60);
  });
  $('#search').addEventListener('input', e => {
    if (composing) return;
    const v = e.target.value;
    clearTimeout(t);
    t = setTimeout(() => runQuery(v), 130);
  });
  $('#sortSel').addEventListener('change', e => {
    if (e.target.value === 'rel' && !state.hits){
      state.sort = 'date'; e.target.value = 'date';
    } else {
      state.sort = e.target.value;
    }
    state.limit = 60; renderList();
  });

  // 关系图
  $('#relClose').addEventListener('click', closeGraph);
  $('#relBack').addEventListener('click', () => {
    if (G.stack.length > 1){ G.stack.pop(); drawGraph(G.stack[G.stack.length - 1]); }
  });
  $('#relModal').addEventListener('click', e => { if (e.target.id === 'relModal') closeGraph(); });
  $('#relCanvas').addEventListener('click', e => {
    // 角标优先：直接看内容，不切换中心
    const v = e.target.closest('[data-view]');
    if (v && v.dataset.view){ viewPaper(v.dataset.view); return; }

    const g = e.target.closest('[data-node]');
    if (!g || !g.dataset.node) return;
    const d = g.dataset.node;
    if (d === G.stack[G.stack.length - 1]) return;
    G.stack.push(d);
    drawGraph(d);
  });
  $('#raCard').addEventListener('click', () => viewPaper($('#raCard').dataset.doi));
  document.addEventListener('keydown', e => {
    if (e.key === '/' && !/^(INPUT|TEXTAREA)$/.test(document.activeElement.tagName)){
      e.preventDefault(); $('#search').focus();
    }
    if (e.key === 'Escape'){
      if ($('#relModal').classList.contains('show')){ closeGraph(); return; }
      const openModalEl = document.querySelector('.modal.show');
      if (openModalEl){ closeModal(openModalEl.id); return; }
      closeSide();
    }
  });

  // 移动端抽屉
  const side = $('#side'), scrim = $('#scrim');
  function openSide(){ side.classList.add('open'); scrim.classList.add('show'); document.body.style.overflow='hidden'; }
  function closeSide(){ side.classList.remove('open'); scrim.classList.remove('show'); document.body.style.overflow=''; }
  $('#filterFab').addEventListener('click', openSide);
  $('#drawerClose').addEventListener('click', closeSide);
  scrim.addEventListener('click', closeSide);
  side.addEventListener('click', e => { if (e.target.closest('.chip') && innerWidth <= 1000) {} });

  // 主题
  const themeBtn = $('#themeBtn');
  function applyTheme(mode){
    document.documentElement.setAttribute('data-theme', mode);
    themeBtn.textContent = mode === 'dark' ? '☀' : '◐';
    try { localStorage.setItem('fd-theme', mode); } catch(_){}
  }
  themeBtn.addEventListener('click', () => {
    applyTheme(document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
  });
  try {
    const saved = localStorage.getItem('fd-theme');
    if (saved) applyTheme(saved);
    else if (window.matchMedia('(prefers-color-scheme: dark)').matches) applyTheme('dark');
  } catch(_){}

  // ---------- 新功能初始化 ----------
  // 点弹层背景关闭
  document.querySelectorAll('.modal').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m) closeModal(m.id); });
  });

  // 问一问
  const askQ = $('#askQ');
  $('#askHints').innerHTML = ASK_HINTS.map(h => `<button class="ask-hint">${esc(h)}</button>`).join('');
  $('#askHints').addEventListener('click', e => {
    const h = e.target.closest('.ask-hint');
    if (!h) return;
    askQ.value = h.textContent;
    runAsk(h.textContent);
  });
  askQ.addEventListener('input', () => {
    askQ.style.height = 'auto';
    askQ.style.height = Math.min(120, askQ.scrollHeight) + 'px';
  });
  askQ.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing){
      e.preventDefault();
      runAsk(askQ.value);
    }
  });
  $('#askSend').addEventListener('click', () => runAsk(askQ.value));

  // 自己的 Key：存本机、随请求带一次
  const keyIn = $('#askKeyIn');
  if (keyIn){
    $('#askKeySave').addEventListener('click', saveUserKey);
    $('#askKeyClear').addEventListener('click', clearUserKey);
    keyIn.addEventListener('keydown', e => {
      if (e.key === 'Enter'){ e.preventDefault(); saveUserKey(); }
    });
    syncKeyUI();
  }

  // 订阅：Blogtrottr 预填 feed 地址
  const subMail = $('#subMail');
  if (subMail) subMail.href = 'https://blogtrottr.com/?subscribe=' + encodeURIComponent(FEED_URL);

  // 没配生成接口就别把入口装成主按钮
  if (!ASK_API){
    const ab = $('#askBtn');
    ab.classList.remove('primary');
    ab.title = '问答接口未配置，点击可先看站内召回结果';
  }

  saveFav();

  // 启动
  try {
    const q0 = new URLSearchParams(location.search).get('q');   // 支持 ?q=大黄鱼 直达搜索结果
    if (q0){ $('#search').value = q0; setQuery(q0); }
  } catch(_){}
  refresh();
})();
</script>
</body>
</html>
